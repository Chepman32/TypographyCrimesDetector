                            <constraint firstItem="icon" firstAttribute="centerY" secondItem="view" secondAttribute="centerY" constant="-24" id="c2"/>
                            <constraint firstItem="wordmark" firstAttribute="top" secondItem="icon" secondAttribute="bottom" constant="20" id="c3"/>
                            <constraint firstItem="wordmark" firstAttribute="centerX" secondItem="view" secondAttribute="centerX" id="c4"/>
