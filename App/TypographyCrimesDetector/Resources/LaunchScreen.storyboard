                        <viewLayoutGuide key="safeArea" id="safe"/>
                        <color key="backgroundColor" red="0.05882352941" green="0.07450980392" blue="0.09411764706" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
